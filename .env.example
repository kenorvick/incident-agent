# Model provider: openrouter | anthropic
MODEL_PROVIDER=openrouter
# Look up the current model ID in the provider's docs; do not guess.
# Anthropic API equivalent (MODEL_PROVIDER=anthropic): claude-sonnet-5-5
MODEL_ID=anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Hard cap on total model spend in USD, enforced from .cache/spend-ledger.jsonl
SPEND_CAP_USD=10

# Telemetry backend: duckdb | honeycomb
TELEMETRY_BACKEND=duckdb
FIXTURES_DIR=fixtures

# Honeycomb (optional, live backend only)
HONEYCOMB_API_KEY=
HONEYCOMB_DATASET=
HONEYCOMB_API_URL=https://api.honeycomb.io
